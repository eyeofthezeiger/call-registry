    {
      "id": "google-workspace.api.calendar.events.insert",
      "provider": "google-workspace",
      "product": "calendar",
      "surface": "api",
      "operation": "calendar.events.insert",
      "summary": "Create an event on a calendar.",
      "tags": [
        "calendar",
        "write"
      ],
      "endpoint": {
        "method": "POST",
        "url": "https://www.googleapis.com/calendar/v3/calendars/{calendarId}/events"
      },
      "params": {
        "required": [
          "calendarId"
        ],
        "optional": [
          "sendUpdates",
          "conferenceDataVersion",
          "supportsAttachments",
          "maxAttendees"
        ],
        "notes": "Body is an Event resource. sendUpdates is all, externalOnly or none. Use none for tests so guests aren't emailed."
      },
      "auth": {
        "methods": [
          "oauth2"
        ],
        "header": "Authorization: Bearer <ACCESS_TOKEN>",
        "scopes": [
          "https://www.googleapis.com/auth/calendar.events",
          "https://www.googleapis.com/auth/calendar",
          "https://www.googleapis.com/auth/calendar.events.owned",
          "https://www.googleapis.com/auth/calendar.app.created"
        ],
        "scopes_mode": "any",
        "least_privilege_scope": "https://www.googleapis.com/auth/calendar.events.owned"
      },
      "config": {
        "generic": "curl -s -X POST -H \"Authorization: Bearer $GOOGLE_ACCESS_TOKEN\" -H \"Content-Type: application/json\" \\\n  -d '{\"summary\":\"Test\",\"start\":{\"dateTime\":\"2026-11-10T15:00:00-05:00\"},\"end\":{\"dateTime\":\"2026-11-10T15:30:00-05:00\"}}' \\\n  \"https://www.googleapis.com/calendar/v3/calendars/primary/events?sendUpdates=none\"\n"
      },
      "source": {
        "url": "https://www.googleapis.com/discovery/v1/apis/calendar/v3/rest",
        "read_on": "2026-11-07",
        "kind": "discovery",
        "spec_revision": "20261102"
      },
      "status": "unverified",
      "last_checked": "2026-11-07",
      "file": "calls/google-workspace/api/google-workspace.api.calendar.events.insert.md",
      "body": ""
    },
    {
      "id": "google-workspace.api.calendar.events.list",
      "provider": "google-workspace",
      "product": "calendar",
      "surface": "api",
      "operation": "calendar.events.list",
      "summary": "List events on a calendar, optionally in a time window.",
      "tags": [
        "calendar",
        "read"
      ],
      "endpoint": {
        "method": "GET",
        "url": "https://www.googleapis.com/calendar/v3/calendars/{calendarId}/events"
      },
      "params": {
        "required": [
          "calendarId"
        ],
        "optional": [
          "timeMin",
          "timeMax",
          "singleEvents",
          "orderBy",
          "maxResults",
          "pageToken",
          "q",
          "timeZone",
          "syncToken",
          "showDeleted",
          "eventTypes"
        ],
        "notes": "calendarId \"primary\" is the signed-in user's main calendar. Use singleEvents=true to expand recurring events (needed for orderBy=startTime)."
      },
      "auth": {
        "methods": [
          "oauth2"
        ],
        "header": "Authorization: Bearer <ACCESS_TOKEN>",
        "scopes": [
          "https://www.googleapis.com/auth/calendar.events.readonly",
          "https://www.googleapis.com/auth/calendar.readonly",
          "https://www.googleapis.com/auth/calendar.events",
          "https://www.googleapis.com/auth/calendar",
          "https://www.googleapis.com/auth/calendar.events.owned.readonly",
          "https://www.googleapis.com/auth/calendar.events.owned",
          "https://www.googleapis.com/auth/calendar.events.public.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.app.created"
        ],
        "scopes_mode": "any",
        "least_privilege_scope": "https://www.googleapis.com/auth/calendar.events.readonly"
      },
      "config": {
        "generic": "curl -s -H \"Authorization: Bearer $GOOGLE_ACCESS_TOKEN\" \\\n  \"https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&orderBy=startTime&timeMin=2026-11-07T00:00:00Z&maxResults=10\"\n"
      },
      "source": {
        "url": "https://www.googleapis.com/discovery/v1/apis/calendar/v3/rest",
        "read_on": "2026-11-07",
        "kind": "discovery",
        "spec_revision": "20261102"
      },
      "status": "unverified",
      "last_checked": "2026-11-07",
      "file": "calls/google-workspace/api/google-workspace.api.calendar.events.list.md",
      "body": "orderBy=startTime only works with singleEvents=true, per the orderBy enum description in the discovery doc."
    },
    {
      "id": "google-workspace.api.docs.documents.get",
      "provider": "google-workspace",
      "product": "docs",
      "surface": "api",
      "operation": "docs.documents.get",
      "summary": "Get the latest version of a Google Doc as structured JSON.",
      "tags": [
        "docs",
        "read"
      ],
      "endpoint": {
        "method": "GET",
        "url": "https://docs.googleapis.com/v1/documents/{documentId}"
      },
      "params": {
        "required": [
          "documentId"
        ],
        "optional": [
          "includeTabsContent",
          "suggestionsViewMode",
          "commentsViewMode"
        ],
        "notes": "With includeTabsContent=true, content comes back in Document.tabs instead of body. Docs with tabs need this to see every tab."
      },
      "auth": {
        "methods": [
          "oauth2"
        ],
        "header": "Authorization: Bearer <ACCESS_TOKEN>",
        "scopes": [
          "https://www.googleapis.com/auth/documents.readonly",
          "https://www.googleapis.com/auth/documents",
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/drive"
        ],
        "scopes_mode": "any",
        "least_privilege_scope": "https://www.googleapis.com/auth/documents.readonly"
      },
      "config": {
        "generic": "curl -s -H \"Authorization: Bearer $GOOGLE_ACCESS_TOKEN\" \\\n  \"https://docs.googleapis.com/v1/documents/$DOC_ID?includeTabsContent=true\"\n"
      },
      "source": {
        "url": "https://docs.googleapis.com/$discovery/rest?version=v1",
        "read_on": "2026-11-07",
        "kind": "discovery",
        "spec_revision": "20261106"
      },
