{
  "name": "call-registry",
  "version": "0.1.0",
  "private": true,
  "description": "A tool-agnostic catalog of single API and MCP calls, each with ready-to-paste config, known errors and a verified/unverified status.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check",
    "check:verified": "node scripts/check-verified.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "ci": "npm run validate && npm test && npm run check:index"
  },
  "dependencies": {},
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
