# Smoke-test credentials. Copy to .env on YOUR machine only (it's gitignored).
# Use your own tokens with the least scope each call lists, and test resources, not real work data.
# Any var left empty makes the tests that need it skip.

# Google Workspace (an OAuth access token with read scopes)
GOOGLE_ACCESS_TOKEN=
GMAIL_TEST_MESSAGE_ID=
GDOCS_TEST_DOC_ID=
GSHEETS_TEST_SHEET_ID=

# Slack (bot or user token; a test channel the bot is in)
SLACK_TOKEN=
SLACK_TEST_CHANNEL=
SLACK_TEST_THREAD_TS=
SLACK_TEST_EMAIL=

# GitHub (REST token and MCP PAT can be the same fine-grained token)
GITHUB_TOKEN=
GITHUB_PAT=
GITHUB_TEST_OWNER=
GITHUB_TEST_REPO=
GITHUB_TEST_PR=

# Jira (site like yoursite.atlassian.net; base64 of email:api_token)
JIRA_SITE=
JIRA_BASIC_AUTH=
JIRA_TEST_ISSUE=

# Figma (personal access token)
FIGMA_TOKEN=
FIGMA_TEST_FILE_KEY=
FIGMA_TEST_NODE_ID=

# Write tests run only with: SMOKE_SANDBOX=1 npm run smoke -- --include-writes
SMOKE_SANDBOX=
# Shown in each result's runner field
SMOKE_RUNNER=
